[gd_resource type="Resource" script_class="Skill" format=3]

[ext_resource type="Script" path="res://src/data/skill.gd" id="1_skill"]
[ext_resource type="Script" path="res://src/data/skill/skill_part.gd" id="2_part"]
[ext_resource type="Script" path="res://src/data/skill/parts/base_power_mult.gd" id="3_base_power_mult"]
[ext_resource type="Script" path="res://src/data/skill/parts/set_counter.gd" id="4_set_counter"]

[sub_resource type="Resource" id="Resource_p1"]
script = ExtResource("3_base_power_mult")
window = 1
mult = "1 + 0.5 * target_counter(\"mark_prey\")"

[sub_resource type="Resource" id="Resource_p2"]
script = ExtResource("4_set_counter")
window = 2
who = 0
counter_id = &"mark_prey"
value = "0"

[resource]
script = ExtResource("1_skill")
id = &"pounce"
display_name = "Pounce"
kind = 0
base_power = 6.0
base_hit_chance = 0.85
cooldown_mult = 1.0
valid_target_positions = Array[int]([0, 1, 2])
targeting = 1
reaches = 0
parts = Array[ExtResource("2_part")]([SubResource("Resource_p1"), SubResource("Resource_p2")])
