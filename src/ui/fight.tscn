[gd_scene format=3 uid="uid://dmvyplf3ub6sh"]

[ext_resource type="Script" uid="uid://fyn5pyt338km" path="res://src/ui/fight.gd" id="1_fight"]
[ext_resource type="Theme" path="res://src/ui/ui_theme.tres" id="2_theme"]

[node name="Fight" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_fight")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="Page" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="PlayerScroll" type="ScrollContainer" parent="Margin/Page"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="PlayerColumn" type="VBoxContainer" parent="Margin/Page/PlayerScroll"]
unique_name_in_owner = true
layout_mode = 2

[node name="Middle" type="VBoxContainer" parent="Margin/Page"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Controls" type="HBoxContainer" parent="Margin/Page/Middle"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="AutoButton" type="Button" parent="Margin/Page/Middle/Controls"]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
text = "Auto play"

[node name="NewFightButton" type="Button" parent="Margin/Page/Middle/Controls"]
layout_mode = 2
text = "New fight"

[node name="SetupButton" type="Button" parent="Margin/Page/Middle/Controls"]
layout_mode = 2
text = "Team setup"

[node name="StatusLabel" type="Label" parent="Margin/Page/Middle"]
unique_name_in_owner = true
layout_mode = 2

[node name="TurnOrderRow" type="HFlowContainer" parent="Margin/Page/Middle"]
unique_name_in_owner = true
layout_mode = 2

[node name="FightLog" type="RichTextLabel" parent="Margin/Page/Middle"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
scroll_following = true

[node name="EnemyScroll" type="ScrollContainer" parent="Margin/Page"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="EnemyColumn" type="VBoxContainer" parent="Margin/Page/EnemyScroll"]
unique_name_in_owner = true
layout_mode = 2

[node name="AutoTimer" type="Timer" parent="."]
unique_name_in_owner = true
wait_time = 0.7

[connection signal="toggled" from="Margin/Page/Middle/Controls/AutoButton" to="." method="_on_auto_toggled"]
[connection signal="pressed" from="Margin/Page/Middle/Controls/NewFightButton" to="." method="_new_fight"]
[connection signal="pressed" from="Margin/Page/Middle/Controls/SetupButton" to="." method="_on_setup_pressed"]
[connection signal="timeout" from="AutoTimer" to="." method="_play_next_turn"]
